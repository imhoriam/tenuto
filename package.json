    "dotenv": "^18.0.4",
    "nanoid": "^6.0.1",
    "next": "16.3.6",
    "prisma": "7.10.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",

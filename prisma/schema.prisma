// Tenuto — reservation holds with no-show protection.
//
// Design notes:
//  - SQLite for the demo (runs offline on a laptop). Prisma enums are not
//    supported on SQLite, so status-like columns are String and the allowed
//    values live in src/lib/constants.ts as const objects. This also makes the
//    eventual move to Postgres a connector change rather than a rewrite.
//  - All money is integer minor units (cents/bani). Never floats.
//  - All timestamps are stored UTC. Render in Business.timezone.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------------------------------------------------------------------
// Tenant
// ---------------------------------------------------------------------------

model Business {
  id       String @id @default(cuid())
  slug     String @unique // public booking URL: /book/<slug>
  name     String
  vertical String // See VERTICAL — restaurant | detailing | clinic | studio
  timezone String @default("Europe/Bucharest")
  currency String @default("RON")

  email String?
  phone String?

  // Payments. Null until the business completes Connect onboarding.
  stripeAccountId    String?
  payoutsEnabled     Boolean @default(false)
  subscriptionStatus String  @default("trialing") // See SUBSCRIPTION_STATUS

  // Policy defaults. Individual services may override the fee.
  cancellationWindowHours Int @default(24)
  noShowFeeCents          Int @default(5000)

  // The "restaurants hold the table 15-20 min" problem, made explicit and
  // enforceable: after this many minutes past startAt with no check-in, the
  // booking becomes markable as a no-show and the slot is released.
  gracePeriodMin Int @default(15)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  locations     Location[]
  resources     Resource[]
  services      Service[]
  scheduleRules ScheduleRule[]
  timeOff       TimeOff[]
  policyRules   PolicyRule[]
  bookings      Booking[]
  customers     CustomerProfile[]

  @@index([slug])
}

model Location {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name    String
  address String?
  lat     Float?
  lng     Float?

  // Rotating secret behind the printed QR code. Signing check-in links with
  // this stops a customer from checking in from home.
  checkInSecret String @default(cuid())

  resources Resource[]
  bookings  Booking[]

  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Capacity
// ---------------------------------------------------------------------------

/// The unit of capacity that can be double-booked.
/// Restaurant: a table (capacity = seats). Detailing: a bay (capacity = 1).
/// Clinic: a practitioner (capacity = 1).
model Resource {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  name     String
  kind     String  @default("table") // See RESOURCE_KIND
  capacity Int     @default(1) // seats for a table; 1 for a chair/bay/person
  active   Boolean @default(true)

  scheduleRules ScheduleRule[]
  timeOff       TimeOff[]
  bookings      Booking[]

  @@index([businessId, active])
}

/// Restaurant: "Dinner, 2h seating". Detailing: "Ceramic coating, 6h".
model Service {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name        String
  description String?
  durationMin Int
  priceCents  Int     @default(0)

  // Cleanup / turnaround. Part of the occupied slot, not of durationMin.
  bufferBeforeMin Int @default(0)
  bufferAfterMin  Int @default(0)

  /// True when the booking carries a party size that must fit Resource.capacity
  /// (restaurants). False when one booking consumes the whole resource.
  usesPartySize Boolean @default(false)

  /// Overrides Business.noShowFeeCents when set. High-ticket services justify
  /// a bigger deposit.
  noShowFeeCents Int?

  active   Boolean   @default(true)
  bookings Booking[]

  @@index([businessId, active])
}

/// Recurring weekly availability. Minutes from local midnight so DST shifts
/// don't move opening hours. resourceId null = applies to the whole business.
model ScheduleRule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  weekday     Int // 0 = Sunday .. 6 = Saturday
  startMinute Int // 1080 = 18:00
  endMinute   Int // 1380 = 23:00

  @@index([businessId, weekday])
}

/// Holidays, maintenance, sick days. Absolute UTC instants.
model TimeOff {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  startAt DateTime
  endAt   DateTime
  reason  String?

  @@index([businessId, startAt, endAt])
}

// ---------------------------------------------------------------------------
// Customers
// ---------------------------------------------------------------------------

/// Platform-wide identity. Phone is the identity — no passwords, no accounts.
/// Reliability counters are global on purpose: a customer who burns one
/// business is a risk to the next one.
model Customer {
  id    String  @id @default(cuid())
  phone String  @unique
  name  String
  email String?

  stripeCustomerId String?

  completedCount   Int @default(0)
  noShowCount      Int @default(0)
  lateCancelCount  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profiles CustomerProfile[]
  bookings Booking[]
  mandates Mandate[]

  @@index([phone])
}

/// Per-business view of a customer: how they behaved *here*. Drives the
/// "regulars skip the card" rule.
model CustomerProfile {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  completedCount Int     @default(0)
  noShowCount    Int     @default(0)
  trusted        Boolean @default(false) // manual override by the business
  notes          String?

  @@unique([businessId, customerId])
  @@index([businessId])
}

// ---------------------------------------------------------------------------
// Risk-based enforcement
// ---------------------------------------------------------------------------

/// Evaluated in ascending priority; first match wins. This is the feature that
/// answers "I don't want to scare my regulars away".
model PolicyRule {
  id         String   @id @default(cuid())
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name     String
  priority Int     @default(100)
  enabled  Boolean @default(true)

  // Conditions — all non-null ones must hold for the rule to match.
  minCompletedHere   Int? // customer has >= N completed bookings here
  hasNoShowHistory   Boolean? // true: only customers with a prior no-show
  minPartySize       Int?
  minServicePriceCents Int?
  appliesOnWeekend   Boolean?

  // Outcome
  requirement    String // See REQUIREMENT — none | card_on_file | deposit
  feeCentsOverride Int?

  @@index([businessId, enabled, priority])
}

// ---------------------------------------------------------------------------
// Bookings
// ---------------------------------------------------------------------------

model Booking {
  id        String @id @default(cuid())
  reference String @unique // short human code, e.g. TNT-4F7K2

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  resourceId String
  resource   Resource @relation(fields: [resourceId], references: [id])
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  // startAt/endAt are the *occupied* window, buffers included.
  startAt   DateTime
  endAt     DateTime
  partySize Int      @default(1)

  status String @default("draft") // See BOOKING_STATUS

  /// What this customer was actually required to do, resolved at booking time.
  requirement String @default("none") // See REQUIREMENT
  feeCents    Int    @default(0)

  /// Set when status enters no_show_pending: the instant the charge becomes
  /// collectable. Gives the business a window to reverse an honest mistake.
  chargeableAt DateTime?

  confirmedAt    DateTime?
  cancelledAt    DateTime?
  checkedInAt    DateTime?
  noShowMarkedAt DateTime?
  completedAt    DateTime?

  customerNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  policySnapshot PolicySnapshot?
  mandate        Mandate?
  charges        Charge[]
  checkIns       CheckIn[]
  events         BookingEvent[]
  notifications  Notification[]

  @@index([businessId, startAt])
  @@index([resourceId, startAt, endAt])
  @@index([status, chargeableAt])
  @@index([customerId])
}

/// Immutable copy of exactly what the customer was shown and agreed to.
/// This is the evidence in a chargeback. Never update a row here.
model PolicySnapshot {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  policyText              String // verbatim, as rendered
  feeCents                Int
  currency                String
  cancellationWindowHours Int
  gracePeriodMin          Int

  acceptedAt DateTime @default(now())
  ipAddress  String?
  userAgent  String?

  @@index([bookingId])
}

/// A stored payment method plus the consent to charge it off-session later.
/// Prisma 7 + Stripe: created via SetupIntent with 3DS, flagged for
/// merchant-initiated transactions.
model Mandate {
  id         String   @id @default(cuid())
  bookingId  String   @unique
  booking    Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  provider          String @default("mock") // mock | stripe
  providerCustomerRef String?
  paymentMethodRef  String?
  setupIntentRef    String?

  status         String  @default("pending") // See MANDATE_STATUS
  cardBrand      String?
  cardLast4      String?
  cardExpMonth   Int?
  cardExpYear    Int?
  threeDSPassed  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerId])
}

/// One row per charge attempt. idempotencyKey is unique — this is what stops
/// a retry or a double-click from charging a customer twice.
model Charge {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  amountCents Int
  currency    String
  status      String @default("pending") // See CHARGE_STATUS

  idempotencyKey String  @unique
  provider       String  @default("mock")
  providerRef    String?

  attempt     Int       @default(1)
  lastError   String?
  nextRetryAt DateTime?

  createdAt   DateTime  @default(now())
  succeededAt DateTime?

  @@index([bookingId])
  @@index([status, nextRetryAt])
}

model CheckIn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  method String // See CHECKIN_METHOD — qr | link | manual
  at     DateTime @default(now())
  lat    Float?
  lng    Float?

  /// Set when a staff member checked the customer in. A manual override may
  /// only ever prevent a charge, never cause one.
  actorLabel String?

  @@index([bookingId])
}

/// Append-only audit of every status transition. Do not delete rows.
model BookingEvent {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  fromStatus String?
  toStatus   String
  actorType  String // See ACTOR — customer | business | system
  actorLabel String?
  reason     String?
  metadata   String? // JSON blob

  at DateTime @default(now())

  @@index([bookingId, at])
}

model Notification {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  channel  String // See CHANNEL — console | sms | whatsapp | email
  template String // confirmation | reminder_48h | reminder_2h | charged | cancelled
  body     String

  status      String    @default("queued") // queued | sent | failed
  sentAt      DateTime?
  providerRef String?
  error       String?

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([status])
}
